/* ─── CppPlace dark theme ─────────────────────────────────────────────────
 * A flat, modern look. The default Qt Fusion/Windows palette is replaced
 * with a desaturated near-black canvas + a single warm accent (#f0c43a).
 * Buttons, inputs, scrollbars, and dialogs are all themed consistently.
 * ───────────────────────────────────────────────────────────────────────── */

QMainWindow, QDialog, QWidget {
    background-color: #1a1a1f;
    color: #d8d8df;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* ─── Status bar ───────────────────────────────────────────────────────── */
QStatusBar {
    background: #14141a;
    color: #aaaab2;
    border-top: 1px solid #2a2a32;
}
QStatusBar QLabel { padding: 2px 8px; }

/* ─── Inputs ────────────────────────────────────────────────────────────── */
QLineEdit {
    background: #25252d;
    border: 1px solid #34343f;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f0f0f4;
    selection-background-color: #f0c43a;
    selection-color: #1a1a1f;
}
QLineEdit:focus { border-color: #f0c43a; }
QLineEdit:disabled { color: #666; background: #1f1f25; }

/* ─── Buttons ───────────────────────────────────────────────────────────── */
QPushButton {
    background: #2c2c36;
    border: 1px solid #3a3a46;
    border-radius: 6px;
    padding: 7px 14px;
    color: #e8e8ee;
}
QPushButton:hover    { background: #353542; border-color: #50505e; }
QPushButton:pressed  { background: #20202a; }
QPushButton:disabled { color: #666; background: #20202a; border-color: #2a2a32; }

QPushButton#primaryButton {
    background: #f0c43a;
    border: 1px solid #f0c43a;
    color: #1a1a1f;
    font-weight: 600;
}
QPushButton#primaryButton:hover   { background: #f7d04f; border-color: #f7d04f; }
QPushButton#primaryButton:pressed { background: #d6ad2c; }

QPushButton#secondaryButton {
    background: transparent;
    border: 1px solid #3a3a46;
    color: #d8d8df;
}
QPushButton#secondaryButton:hover { border-color: #f0c43a; color: #f0c43a; }

/* ─── Login dialog accents ─────────────────────────────────────────────── */
QLabel#loginTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f0c43a;
    letter-spacing: 1px;
}
QLabel#loginSubtitle {
    color: #8a8a94;
    font-size: 12px;
}
QLabel#loginStatus {
    color: #ff7777;
    font-size: 11px;
    min-height: 14px;
}

/* ─── Scroll area / scroll bars ────────────────────────────────────────── */
QScrollArea { border: none; background: #101015; }

QScrollBar:vertical, QScrollBar:horizontal {
    background: #14141a;
    border: none;
    width:  10px;
    height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #34343f;
    border-radius: 5px;
    min-height: 24px;
    min-width:  24px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #50505e;
}
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ─── Tooltips ─────────────────────────────────────────────────────────── */
QToolTip {
    background: #2c2c36;
    color: #f0f0f4;
    border: 1px solid #3a3a46;
    border-radius: 4px;
    padding: 4px 8px;
}
